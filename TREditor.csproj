<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' and '$(MetricsScope)' != 'true' ">
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TestFramework>GdUnit4</TestFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="addons\TilingContainer\tests\**" />
    <Compile Remove="tests\**" />
    <None Remove="addons\TilingContainer\tests\**" />
    <None Remove="tests\**" />
    <Compile Remove="vendor\**" />
    <None Remove="vendor\**" />
    <!-- The pinned Gizmo3D node is compiled from the submodule, along with the helper extensions it
         needs for engine APIs that have no C# binding. Its editor plugin loader and demo sources stay
         excluded, so the upstream addon is never enabled. -->
    <Compile Include="vendor\Gizmo3D\addons\Gizmo3DSharp\Gizmo3D.cs" />
    <Compile Include="vendor\Gizmo3D\addons\Gizmo3DSharp\GizmoHelper.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" />
    <ProjectReference Include="vendor\TRMesh\tr-mesh.csproj" />
    <InternalsVisibleTo Include="TREditor.Tests" />
  </ItemGroup>
  <ItemGroup Condition=" '$(Configuration)' == 'Debug' and '$(MetricsScope)' != 'true' ">
    <Compile Include="tests\TREditor.GodotTests\*.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" PrivateAssets="all" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" PrivateAssets="all" />
  </ItemGroup>
  <!-- Build-time analysis only: PrivateAssets keeps these out of compile/publish output and
       dependency graphs. Gated to Debug by default; Release can opt in with
       -p:EnableDevCodeAnalysis=true (e.g. for `dotnet build -t:Metrics`). Analyzers emit
       diagnostics only — they do not rewrite IL. -->
  <ItemGroup Condition=" '$(Configuration)' == 'Debug' or '$(EnableDevCodeAnalysis)' == 'true' ">
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>
  <!-- Metrics-only compile filter. Metrics.exe reloads the project without MSBuild -p
       flags, so scripts/run-metrics.ps1 sets the MetricsScope *environment* variable
       (MSBuild promotes env vars to properties). Normal Debug/Release builds are unchanged. -->
  <ItemGroup Condition="'$(MetricsScope)' == 'true'">
    <Compile Remove="tests\**" />
    <Compile Remove="vendor\**" />
    <Compile Remove="addons\**" />
    <Compile Remove="gdunit4_testadapter_v5\**" />
    <Compile Include="addons\TilingContainer\**\*.cs" Exclude="addons\TilingContainer\tests\**" />
  </ItemGroup>
  <Target Name="EnsureGdUnit4Installed" BeforeTargets="PrepareForBuild" Condition="!Exists('$(MSBuildProjectDirectory)\addons\gdUnit4\plugin.cfg')">
    <Error Text="GdUnit4 is not initialized. Follow the setup instructions in BUILD.md." />
  </Target>
</Project>
