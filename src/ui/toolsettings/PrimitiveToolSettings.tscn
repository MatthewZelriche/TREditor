item_count = 2
popup/item_0/text = "Box"
popup/item_0/id = 0
popup/item_1/text = "Cylinder"
popup/item_1/id = 1

[node name="SidesRow" type="HBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="SidesLabel" type="Label" parent="SidesRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Sides"

[node name="SidesSpin" type="SpinBox" parent="SidesRow"]
unique_name_in_owner = true
layout_mode = 2
min_value = 3.0
max_value = 64.0
value = 16.0
allow_greater = false
allow_lesser = false

[connection signal="item_selected" from="ShapeOption" to="." method="OnShapeSelected"]
[connection signal="value_changed" from="SidesRow/SidesSpin" to="." method="OnSidesChanged"]
